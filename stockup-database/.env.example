# CREAO keys. An app key (capi_...) made on an agent's page in agent.creao.ai only runs THAT agent
# (any other agent answers APP_SCOPE_RESTRICTED), so give each agent its own key below.
# CREAO_API_KEY is used for any agent that has no key of its own.
CREAO_API_KEY=
CREAO_AGRI_API_KEY=
CREAO_ARTIST_API_KEY=
CREAO_REALIST_API_KEY=
CREAO_MILESTONE_API_KEY=
CREAO_APP_ID=1dba2b6d-dcfd-4e4d-84fd-a431a7ad8e1b
CREAO_AGRI_AGENT_ID=d8cf6a89-b74e-40a1-9bc6-6595e291a8dc
CREAO_AGRI_AGENT_VERSION=05840d54-335b-47d9-9d74-9db8fbf57399
CREAO_ARTIST_AGENT_ID=cd6605d4-2f11-4fad-9ae9-06b34fd10c2c
CREAO_ARTIST_AGENT_VERSION=c70fb963-b56d-4242-90ef-349924b139bc
CREAO_REALIST_AGENT_ID=8b1813ab-1099-43f6-a64d-3b3ff7eddd44
CREAO_REALIST_AGENT_VERSION=3fa8539a-b941-4dfe-bba9-5112d8a1b86e
CREAO_MILESTONE_AGENT_ID=59fbfe03-06dc-4add-b42d-c2c6ec377a1b
CREAO_MILESTONE_AGENT_VERSION=6f1fcbbd-ad56-461f-a51a-73f5ada67743
STOCK_PRICE_API_KEY=demo
# auto uses Coinbase for Agents CLI when installed/authenticated, then safe public/fallback quotes
COINBASE_AGENT_MODE=auto
# COINBASE_CLI_BIN=/absolute/path/to/coinbase
PORT=8787

# Zinc sandbox key: curl -X POST https://api.zinc.com/sandbox/keys
ZINC_API_KEY=

# SpacetimeDB host for the client (default ws://localhost:3000)
# VITE_SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
